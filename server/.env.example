user=postgres_user
password=supabase_password
host=supabase_host
port=supabase_port
dbname=supabase_dbname
# OpenAI — used for GPT-4o-mini chat streaming AND Whisper speech-to-text
OPENAPI=YOUR_OPENAI_KEY
TOPIC_ASSIGNMENT_THRESHOLD_SIMILARITY=0.48
TOPIC_SIMILARITY_THRESHOLD=0.2
IDEA_SIMILARITY_THRESHOLD=0.4
TOPIC_AUTO_REFINEMENT_THRESHOLD=3
BULK_IDEA_INSERTION_THRESHOLD=4
RECENCY_THRESHOLD=7
DOMINANCE_THRESHOLD=15
# Paste the JWT Secret from Supabase → Project Settings → API (not the anon/service role keys).
# Only used when access tokens are signed with HS256 (legacy / shared-secret).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Same URL as the app’s EXPO_PUBLIC_SUPABASE_URL (https://<ref>.supabase.co).
# Required when Supabase uses JWT Signing Keys (ES256/RS256) — tokens are verified via JWKS.
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional override (default: {SUPABASE_URL}/auth/v1/.well-known/jwks.json)
# SUPABASE_JWKS_URL=

# ── Connectors (Google Calendar / Google Tasks / Gmail — separate Web OAuth client from Supabase login) ───
# Create a Web application OAuth client in Google Cloud. Add every backend callback you use:
#   - Calendar: GOOGLE_CONNECTOR_REDIRECT_URI
#   - Tasks:    GOOGLE_TASKS_CONNECTOR_REDIRECT_URI (required; path must be /connectors/google_tasks/callback)
#   - Gmail:    GOOGLE_GMAIL_CONNECTOR_REDIRECT_URI (path must be /connectors/gmail/callback)
# Enable APIs in Google Cloud → APIs & Services → Library: Google Calendar API, Google Tasks API, Gmail API.
# Gmail OAuth scopes (see server/connectors/providers/gmail/connector.py): gmail.readonly, gmail.compose,
# gmail.send, plus openid and userinfo.email for account identity.
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=
GOOGLE_CONNECTOR_REDIRECT_URI=http://127.0.0.1:8000/connectors/google_calendar/callback
# Tasks callback — same host/port as Calendar, path …/google_tasks/callback. Must be listed in Google Cloud.
# Omit this to derive from GOOGLE_CONNECTOR_REDIRECT_URI (swap google_calendar → google_tasks).
GOOGLE_TASKS_CONNECTOR_REDIRECT_URI=http://127.0.0.1:8000/connectors/google_tasks/callback
# Gmail callback — register this exact URI under the same OAuth Web client. If unset, derived from
# GOOGLE_CONNECTOR_REDIRECT_URI by swapping google_calendar → gmail (when that URI contains google_calendar).
GOOGLE_GMAIL_CONNECTOR_REDIRECT_URI=http://127.0.0.1:8000/connectors/gmail/callback
# Fernet-derived key material — use a long random string in production
CONNECTOR_ENCRYPTION_SECRET=change-me-min-16-chars-for-connectors
CONNECTOR_OAUTH_STATE_TTL_SECONDS=600
# Default return URL after OAuth if the client omits return_to (web)
FRONTEND_CONNECTOR_BASE_URL=http://localhost:8081

# ── Notion (public integration — separate from Google) ───────────────────────
# Create a public integration at https://www.notion.so/my-integrations
# Redirect URI: must match Notion dashboard AND this value exactly (http for local uvicorn, not https).
# If the Notion "Redirect URIs" box won't accept typing: clear it, paste ONE line only (no Enter), save.
# Alternative loopback (same machine): http://localhost:8000/connectors/notion/callback — use the same string in Notion + here.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_CONNECTOR_REDIRECT_URI=http://127.0.0.1:8000/connectors/notion/callback
# Optional; defaults to 2022-06-28 if unset (must match token + API calls)
# NOTION_API_VERSION=2022-06-28
