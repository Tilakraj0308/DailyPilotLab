user=postgres_user
password=supabase_password
host=supabase_host
port=supabase_port
dbname=supabase_dbname
# OpenAI — used for GPT-4o-mini chat streaming AND Whisper speech-to-text
OPENAPI=YOUR_OPENAI_KEY
TOPIC_ASSIGNMENT_THRESHOLD_SIMILARITY=0.48
TOPIC_SIMILARITY_THRESHOLD=0.2
IDEA_SIMILARITY_THRESHOLD=0.4
TOPIC_AUTO_REFINEMENT_THRESHOLD=3
BULK_IDEA_INSERTION_THRESHOLD=4
RECENCY_THRESHOLD=7
DOMINANCE_THRESHOLD=15
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Calendar Connector
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/connectors/google/calendar/callback
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
CONNECTOR_ENCRYPTION_KEY=base64-encoded-32-byte-key
