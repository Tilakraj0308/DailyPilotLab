user=postgres_user
password=supabase_password
host=supabase_host
port=supabase_port
dbname=supabase_dbname
# OpenAI — used for GPT-4o-mini chat streaming AND Whisper speech-to-text
OPENAPI=YOUR_OPENAI_KEY
TOPIC_ASSIGNMENT_THRESHOLD_SIMILARITY=0.48
TOPIC_SIMILARITY_THRESHOLD=0.2
IDEA_SIMILARITY_THRESHOLD=0.4
TOPIC_AUTO_REFINEMENT_THRESHOLD=3
BULK_IDEA_INSERTION_THRESHOLD=4
RECENCY_THRESHOLD=7
DOMINANCE_THRESHOLD=15
# Paste the JWT Secret from Supabase → Project Settings → API (not the anon/service role keys).
# Only used when access tokens are signed with HS256 (legacy / shared-secret).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Same URL as the app’s EXPO_PUBLIC_SUPABASE_URL (https://<ref>.supabase.co).
# Required when Supabase uses JWT Signing Keys (ES256/RS256) — tokens are verified via JWKS.
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional override (default: {SUPABASE_URL}/auth/v1/.well-known/jwks.json)
# SUPABASE_JWKS_URL=

# ── Connectors (Google Calendar — separate OAuth client from Supabase login) ───
# Create a Web application OAuth client in Google Cloud; authorized redirect URI must match
# GOOGLE_CONNECTOR_REDIRECT_URI exactly (e.g. http://127.0.0.1:8000/connectors/google_calendar/callback).
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=
GOOGLE_CONNECTOR_REDIRECT_URI=http://127.0.0.1:8000/connectors/google_calendar/callback
# Fernet-derived key material — use a long random string in production
CONNECTOR_ENCRYPTION_SECRET=change-me-min-16-chars-for-connectors
CONNECTOR_OAUTH_STATE_TTL_SECONDS=600
# Default return URL after OAuth if the client omits return_to (web)
FRONTEND_CONNECTOR_BASE_URL=http://localhost:8081
